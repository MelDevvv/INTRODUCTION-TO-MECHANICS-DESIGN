<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="PlatformerUI.uss" />
    <ui:VisualElement name="root" class="root">
        <ui:VisualElement class="world-dim" />
        <ui:VisualElement class="ambient-ground" />

        <!-- HUD -->
        <ui:VisualElement name="hud" class="hud">
            <ui:VisualElement class="brand-block">
                <ui:VisualElement class="cube-mark">
                    <ui:VisualElement class="cube-mark-top" />
                    <ui:VisualElement class="cube-mark-face" />
                    <ui:VisualElement class="cube-mark-side" />
                </ui:VisualElement>
                <ui:VisualElement class="brand-copy">
                    <ui:Label text="NOT A REAL" class="brand-title" />
                    <ui:Label text="PLATFORMER // 2D ADVENTURE" class="brand-subtitle" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="hud-right">
                <ui:VisualElement class="hud-stat">
                    <ui:Label text="DEATHS" class="hud-stat-title" />
                    <ui:Label name="death-count" text="00" class="hud-stat-value death-value" />
                </ui:VisualElement>
                <ui:VisualElement class="hud-stat">
                    <ui:Label text="LEVEL" class="hud-stat-title" />
                    <ui:Label name="level-name" text="01" class="hud-stat-value" />
                </ui:VisualElement>
                <ui:VisualElement class="hud-stat timer-stat">
                    <ui:Label text="RUN TIME" class="hud-stat-title" />
                    <ui:Label name="run-timer" text="00:00.00" class="hud-stat-value timer-value" />
                    <ui:Label name="best-time" text="BEST  --:--.--" class="timer-best" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Start prompt: the player remains animated until any input is pressed. -->
        <ui:VisualElement name="start-prompt" class="start-prompt">
            <ui:VisualElement class="start-prompt-accent" />
            <ui:Label text="PRESS ANY BUTTON" class="start-prompt-title" />
            <ui:Label text="TO BEGIN YOUR RUN" class="start-prompt-subtitle" />
            <ui:Label text="A / D MOVE     SPACE JUMP     CTRL PRECISION WALK" class="start-prompt-controls" />
        </ui:VisualElement>

        <!-- Signpost Interaction Prompt -->
        <ui:VisualElement name="signpost-prompt" class="signpost-prompt">
            <ui:Label text="E" class="signpost-prompt-key" />
            <ui:Label text="READ SIGN" class="signpost-prompt-label" />
        </ui:VisualElement>

        <!-- Signpost Message -->
        <ui:VisualElement name="signpost-panel" class="signpost-panel">
            <ui:VisualElement class="signpost-header">
                <ui:VisualElement class="signpost-indicator" />
                <ui:Label text="WORLD MESSAGE" class="signpost-heading" />
                <ui:Label text="E  CLOSE" class="signpost-close-hint" />
            </ui:VisualElement>
            <ui:Label name="signpost-message" text="" class="signpost-message" />
        </ui:VisualElement>

        <!-- Menus -->
        <ui:VisualElement name="screen-overlay" class="screen-overlay">
            <ui:VisualElement name="menu-frame" class="menu-frame">
                <ui:VisualElement class="grass-trim">
                    <ui:VisualElement class="grass-pixel grass-pixel-one" />
                    <ui:VisualElement class="grass-pixel grass-pixel-two" />
                    <ui:VisualElement class="grass-pixel grass-pixel-three" />
                    <ui:VisualElement class="grass-pixel grass-pixel-four" />
                    <ui:VisualElement class="grass-pixel grass-pixel-five" />
                    <ui:VisualElement class="grass-pixel grass-pixel-six" />
                </ui:VisualElement>
                <ui:VisualElement class="menu-paper">
                    <ui:VisualElement class="menu-eyebrow-row">
                        <ui:VisualElement class="status-pixel" />
                        <ui:Label name="screen-kicker" text="TAKE A BREATHER" class="menu-eyebrow" />
                    </ui:VisualElement>
                    <ui:Label name="screen-title" text="PAUSED" class="menu-title" />
                    <ui:Label name="screen-description" text="Your run is paused. Take a moment before jumping back in." class="menu-description" />
                    <ui:VisualElement class="button-stack">
                        <ui:Button name="primary-button" text="RESUME GAME" class="pixel-button primary-button" />
                        <ui:Button name="secondary-button" text="RESTART LEVEL" class="pixel-button secondary-button" />
                        <ui:Button name="tertiary-button" text="MAIN MENU" class="pixel-button tertiary-button" />
                    </ui:VisualElement>
                    <ui:Label name="screen-footer" text="PRESS ESC TO RESUME" class="menu-footer" />
                </ui:VisualElement>
                <ui:VisualElement class="dirt-trim">
                    <ui:VisualElement class="dirt-pixel dirt-pixel-one" />
                    <ui:VisualElement class="dirt-pixel dirt-pixel-two" />
                    <ui:VisualElement class="dirt-pixel dirt-pixel-three" />
                    <ui:VisualElement class="dirt-pixel dirt-pixel-four" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="toast" class="toast">
            <ui:VisualElement class="toast-icon" />
            <ui:Label name="toast-label" text="LEVEL RESTARTED" class="toast-label" />
        </ui:VisualElement>

        <!-- Full-screen loading transition used when returning to MainMenu. -->
        <ui:VisualElement name="scene-loading-overlay" class="scene-loading-overlay">
            <ui:VisualElement class="scene-loading-panel">
                <ui:VisualElement class="scene-loading-emblem">
                    <ui:VisualElement class="scene-loading-emblem-top" />
                    <ui:VisualElement class="scene-loading-emblem-front" />
                    <ui:VisualElement class="scene-loading-emblem-side" />
                </ui:VisualElement>
                <ui:Label text="NOT A REAL PLATFORMER" class="scene-loading-brand" />
                <ui:Label name="scene-loading-title" text="RETURNING TO MAIN MENU" class="scene-loading-title" />
                <ui:Label text="GETTING THINGS READY..." class="scene-loading-subtitle" />
                <ui:VisualElement class="scene-loading-bar">
                    <ui:VisualElement name="scene-loading-bar-fill" class="scene-loading-bar-fill" />
                </ui:VisualElement>
                <ui:Label text="PLEASE WAIT" class="scene-loading-footer" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
